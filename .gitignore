# Python
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
dist/
build/
*.egg

# Virtual Environment
.venv/
venv/
env/

# IDE
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# OS
Thumbs.db
Desktop.ini
.DS_Store

# User config (keep default, ignore user overrides)
# 正式运行时 user.json 已迁到 %APPDATA%/GBC Nina/config/；
# 这里的 config/user.json 只在开发机上存在，作为迁移源。
config/user.json

# Atomic-write artifacts (temp file, rolling backup, quarantined corrupt file)
*.tmp
*.bak
*.corrupt

# Environment variables (API keys, secrets)
.env

# Data (runtime data, not source)
# 运行期数据默认在 %APPDATA%/GBC Nina/，以下是开发/便携模式下的本地副本
data/
data_portable/
temp/
portable.txt

# Logs
logs/
*.log

# Models (downloaded, not source)
VOICE_WAKE_DEBUG_LOG.md
fbank_lfr_cmvn_feature.json

# PyInstaller: only track the curated release spec (GBC.Nina.v*.spec).
# Auto-generated / legacy specs stay ignored.
*.spec
!GBC.Nina.v*.spec
