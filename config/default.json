{
  "app": {
    "debug": false,
    "version": "0.1.0"
  },
  "window": {
    "size_scale": 1.0,
    "opacity": 0.95,
    "always_on_top": true
  },
  "animation": {
    "idle_fps": 6,
    "walk_fps": 8,
    "typing_fps": 8,
    "watching_fps": 6,
    "sleep_fps": 2
  },
  "behavior": {
    "auto_move": true,
    "dialogue_enabled": true,
    "auto_sleep_timeout": 300,
    "debug_sleep_timeout": 10,
    "idle_duration_min": 5000,
    "idle_duration_max": 15000,
    "walk_duration_min": 3000,
    "walk_duration_max": 8000,
    "idle_to_walk_chance": 0.3,
    "sleep_after_inactive_ms": 300000
  },
  "pet": {
    "name": "Nina",
    "default_x": -1,
    "default_y": -1
  },
  "voice": {
    "enabled": true,
    "provider": "hybrid",
    "api_key": "",
    "language": "zh",
    "sample_rate": 16000,
    "channels": 1,
    "min_confidence": 0.5,
    "max_concurrent_analyze": 8,
    "emotion_map": {
      "HAPPY": "HAPPY",
      "SAD": "SAD",
      "ANGRY": "ANGRY",
      "NEUTRAL": "NEUTRAL",
      "FEARFUL": "SAD",
      "DISGUSTED": "ANGRY",
      "SURPRISED": "HAPPY",
      "EMO_UNKNOWN": "UNKNOWN"
    },
    "sentiment_map": {
      "POSITIVE": "HAPPY",
      "NEUTRAL": "NEUTRAL",
      "NEGATIVE": "SAD"
    },
    "segment_mode": "vad",
    "segment_max_seconds": 15.0,
    "segment_min_seconds": 1.0,
    "segment_silence_ms": 700,
    "segment_silence_rms_threshold": 400,
    "assemblyai": {
      "api_key": "",
      "language": "en",
      "timeout": 60
    },
    "sensevoice": {
      "exe_path": "bin/sense-voice-main.exe",
      "model_path": "models/sense-voice-small-q8_0.gguf",
      "temp_path": "temp",
      "language": "zh",
      "timeout": 30.0,
      "n_threads": 8
    },
    "hybrid": {
      "allow_partial_provider": true,
      "max_workers": 2
    },
    "commands": {
      "enabled": true,
      "wake_words": ["hey nina", "小猫", "nina"],
      "wake_timeout_ms": 5000,
      "custom": [
        {
          "trigger": "几点了",
          "action": "show_time",
          "description": "显示当前时间"
        },
        {
          "trigger": "今天几号",
          "action": "show_date",
          "description": "显示当前日期"
        },
        {
          "trigger": "早上好",
          "action": "show_greeting",
          "description": "显示问候语"
        },
        {
          "trigger": "开心",
          "action": "play_happy",
          "description": "播放开心动画"
        },
        {
          "trigger": "跳舞",
          "action": "play_dance",
          "description": "播放跳舞动画"
        },
        {
          "trigger": "状态",
          "action": "show_status",
          "description": "显示状态信息"
        }
      ]
    }
  }
}
