{
  "app": {
    "debug": false,
    "version": "0.1.0"
  },
  "window": {
    "size_scale": 1.0,
    "opacity": 0.95,
    "always_on_top": true
  },
  "animation": {
    "idle_fps": 6,
    "walk_fps": 8,
    "typing_fps": 8,
    "watching_fps": 6,
    "sleep_fps": 2
  },
  "behavior": {
    "auto_move": true,
    "dialogue_enabled": true,
    "auto_sleep_timeout": 300,
    "debug_sleep_timeout": 10,
    "idle_duration_min": 5000,
    "idle_duration_max": 15000,
    "walk_duration_min": 3000,
    "walk_duration_max": 8000,
    "idle_to_walk_chance": 0.3,
    "sleep_after_inactive_ms": 300000
  },
  "pet": {
    "name": "Nina",
    "default_x": -1,
    "default_y": -1
  },
  "voice": {
    "enabled": true,
    "provider": "hybrid",
    "api_key": "",
    "language": "zh",
    "sample_rate": 16000,
    "channels": 1,
    "min_confidence": 0.5,
    "emotion_map": {
      "HAPPY": "HAPPY",
      "SAD": "SAD",
      "ANGRY": "ANGRY",
      "NEUTRAL": "NEUTRAL",
      "FEARFUL": "SAD",
      "DISGUSTED": "ANGRY",
      "SURPRISED": "HAPPY",
      "EMO_UNKNOWN": "UNKNOWN"
    },
    "sentiment_map": {
      "POSITIVE": "HAPPY",
      "NEUTRAL": "NEUTRAL",
      "NEGATIVE": "SAD"
    },
    "segment_mode": "vad",
    "segment_max_seconds": 15.0,
    "segment_min_seconds": 1.0,
    "segment_silence_ms": 700,
    "segment_silence_rms_threshold": 400,
    "assemblyai": {
      "api_key": "",
      "language": "en",
      "timeout": 60
    },
    "sensevoice": {
      "exe_path": "bin/llama-funasr-sensevoice.exe",
      "model_path": "models/sensevoice-small-q8.gguf",
      "vad_path": "models/fsmn-vad.gguf",
      "temp_path": "temp",
      "timeout": 30.0,
      "n_threads": 8
    },
    "hybrid": {
      "allow_partial_provider": true,
      "max_workers": 2
    }
  }
}
